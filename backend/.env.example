# ORBiALOG API — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas SRV connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.gwdogm2.mongodb.net/orbialog?retryWrites=true&w=majority

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin seed credentials (never hardcode in source)
ADMIN_EMAIL=admin@orbialog.space
ADMIN_PASSWORD=change_me_strong_password

LOG_LEVEL=info
