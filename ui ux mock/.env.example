# ORBiALOG Frontend Environment Variables

# Backend API Base URL
# Option A: In development with Vite proxy (defaults to http://localhost:4000 via vite.config.ts)
VITE_API_URL=/api/v1

# Option B: Direct connection to local backend
# VITE_API_URL=http://localhost:4000/api/v1

# Option C: Remote deployed backend (e.g., staging or production server)
# VITE_API_URL=https://api.orbialog.space/api/v1
